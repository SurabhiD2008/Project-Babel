{
  "name": "babel-backend",
  "version": "1.0.0",
  "description": "Project Babel API — Express + Prisma backend (spec §6–§7)",
  "license": "MIT",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed": "node prisma/seed.js",
    "setup": "prisma generate && prisma db push --skip-generate && node prisma/seed.js",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "2.4.3",
    "express": "4.22.3",
    "jsonwebtoken": "9.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  },
  "overrides": {
    "effect": "3.22.5",
    "deepmerge-ts": "8.0.2"
  },
  "engines": {
    "node": "22.x"
  }
}
