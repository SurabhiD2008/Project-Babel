# Copy this file to `.env` and fill in real values. In production these are
# set as Vercel environment variables (the Neon integration provides
# DATABASE_URL and DATABASE_URL_UNPOOLED). The server refuses to start if a
# required value is missing or too short.

# PostgreSQL (Neon). Pooled URL for the app; unpooled/direct for schema changes.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Required. Signs session cookies. At least 32 characters; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional. Unlocks /api/admin/* and the #/admin page. At least 32 characters
# when set; leave empty to keep admin routes closed.
ADMIN_KEY=

# Local server port (optional, default 4600).
PORT=

# Optional. With a key, Name My Feeling and submission screening use Claude
# within the daily cap below; without one they use the offline engine.
ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-4-8).
ANTHROPIC_MODEL=
# Optional cap on Claude calls per day across all visitors (default 300).
CLAUDE_DAILY_CAP=
